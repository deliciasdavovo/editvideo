},
{
"text": "Todos velhos demais para servir.",
"t0": 10.64,
"t1": 14.379900000000003,
"speaker": null,
"clip": "b01a"
},
{
"text": "Tudo começou quando o burro",
"t0": 14.460099999999999,
"t1": 17.416562882096077,
"speaker": null,
"clip": "b01b"
},
{
"text": "foi mandado embora.",
"t0": 17.416562882096077,
"t1": 18.86027467248909,
"speaker": null,
"clip": "b01b"
},
{
"text": "O dono decidiu que ele",
"t0": 18.86027467248909,
"t1": 21.08809126637555,
"speaker": null,
"clip": "b01b"
},
{
"text": "já não servia para nada.",
"t0": 21.08809126637555,
"t1": 22.960449344978173,
"speaker": null,
"clip": "b01b"
},
{
"text": "O burro tinha outra opinião.",
"t0": 22.960449344978173,
"t1": 26.2801,
"speaker": null,
"clip": "b01b"
},
{
"text": "Vou para Bremen.",
"t0": 26.2801,
"t1": 27.3,
"speaker": "BURRO",
"clip": "b02_burro"
},
{
"text": "Vou ser músico!",
"t0": 27.3,
"t1": 29.060100000000002,
"speaker": "BURRO",
"clip": "b02_burro"
},
{
"text": "Na estrada, achou um cachorro",
"t0": 29.060100000000002,
"t1": 31.598745833333332,
"speaker": null,
"clip": "n03a"
},
{
"text": "velho demais para caçar.",
"t0": 31.598745833333332,
"t1": 33.87010000000001,
"speaker": null,
"clip": "n03a"
},
{
"text": "Ainda sabe latir?",
"t0": 33.87010000000001,
"t1": 35.5199,
"speaker": "BURRO",
"clip": "burro_latir"
},
{
"text": "Está contratado.",
"t0": 36.630100000000006,
"t1": 38.670100000000005,
"speaker": "BURRO",
"clip": "burro_contratado"
},
{
"text": "Depois, um gato",
"t0": 38.670100000000005,
"t1": 40.245554545454546,
"speaker": null,
"clip": "n03b"
},
{
"text": "que não pegava ratos.",
"t0": 40.245554545454546,
"t1": 43.11010000000001,
"speaker": null,
"clip": "n03b"
},
{
"text": "Tenho outros talentos.",
"t0": 43.11010000000001,
"t1": 46.100100000000005,
"speaker": "GATO",
"clip": "gato_talentos"
},
{
"text": "E um galo que ia",
"t0": 46.100100000000005,
"t1": 47.66598235294118,
"speaker": null,
"clip": "n03c"
},
{
"text": "virar sopa amanhã.",
"t0": 47.66598235294118,
"t1": 50.2099,
"speaker": null,
"clip": "n03c"
},
{
"text": "Mas a noite caiu,",
"t0": 53.48010000000001,
"t1": 54.81915263157895,
"speaker": null,
"clip": "n04"
},
{
"text": "e eles tinham fome e frio.",
"t0": 54.81915263157895,
"t1": 57.3561,
"speaker": null,
"clip": "n04"
},
{
"text": "Viram uma casa iluminada.",
"t0": 57.3561,
"t1": 60.8519947368421,
"speaker": null,
"clip": "n04"
},
{
"text": "Lá dentro, três ladrões",
"t0": 60.8519947368421,
"t1": 62.80052105263158,
"speaker": null,
"clip": "n04"
},
{
"text": "se fartavam.",
"t0": 62.80052105263158,
"t1": 64.49010000000001,
"speaker": null,
"clip": "n04"
},
{
"text": "Precisamos de um plano.",
"t0": 64.49010000000001,
"t1": 67.04010000000001,
"speaker": "GATO",
"clip": "gato_plano"
},
{
"text": "Um concerto.",
"t0": 67.04010000000001,
"t1": 69.10990000000001,
"speaker": "BURRO",
"clip": "burro_concerto"
},
{
"text": "O burro embaixo,",
"t0": 69.47010000000002,
"t1": 70.67023452914799,
"speaker": null,
"clip": "n05a"
},
{
"text": "o cachorro em cima,",
"t0": 70.67023452914799,
"t1": 72.7822076233184,
"speaker": null,
"clip": "n05a"
},
{
"text": "depois o gato e o galo.",
"t0": 72.7822076233184,
"t1": 75.35785784753365,
"speaker": null,
"clip": "n05a"
},
{
"text": "Na janela, a sombra",
"t0": 75.35785784753365,
"t1": 76.94983094170405,
"speaker": null,
"clip": "n05a"
},
{
"text": "virou um monstro.",
"t0": 76.94983094170405,
"t1": 77.97812690582961,
"speaker": null,
"clip": "n05a"
},
{
"text": "E os quatro cantaram.",
"t0": 77.97812690582961,
"t1": 80.94990000000001,
"speaker": null,
"clip": "n05a"
},
{
"text": "Foi a primeira apresentação",
"t0": 83.64010000000002,
"t1": 85.7073093023256,
"speaker": null,
"clip": "n05b"
},
{
"text": "da banda.",
"t0": 85.7073093023256,
"t1": 86.66870465116281,
"speaker": null,
"clip": "n05b"
},
{
"text": "E, pelo desespero da plateia,",
"t0": 86.66870465116281,
"t1": 89.64637906976746,
"speaker": null,
"clip": "n05b"
},
{
"text": "provavelmente a última.",
"t0": 89.64637906976746,
"t1": 92.42990000000002,
"speaker": null,
"clip": "n05b"
},
{
"text": "Um ladrão voltou no escuro.",
"t0": 92.54010000000002,
"t1": 94.36402070484586,
"speaker": null,
"clip": "n06"
},
{
"text": "Levou uma arranhada,",
"t0": 94.36402070484586,
"t1": 96.63732466960354,
"speaker": null,
"clip": "n06"
},
{
"text": "uma mordida e um coice.",
"t0": 96.63732466960354,
"t1": 98.99124537444935,
"speaker": null,
"clip": "n06"
},
{
"text": "E jurou aos outros",
"t0": 98.99124537444935,
"t1": 100.15494581497799,
"speaker": null,
"clip": "n06"
},
{
"text": "que a casa estava cheia",
"t0": 100.15494581497799,
"t1": 101.76987973568284,
"speaker": null,
"clip": "n06"
},
{
"text": "de monstros.",
"t0": 101.76987973568284,
"t1": 103.18990000000002,
"speaker": null,
"clip": "n06"
},
{
"text": "Os quatro nunca",
"t0": 103.35010000000003,
"t1": 104.71784869109949,
"speaker": null,
"clip": "n07"
},
{
"text": "chegaram a Bremen.",
"t0": 104.71784869109949,
"t1": 106.8084769633508,
"speaker": null,
"clip": "n07"
},
{
"text": "Mas encontraram um lugar",
"t0": 106.8084769633508,
"t1": 109.09287486910996,
"speaker": null,
"clip": "n07"
},
{
"text": "onde envelhecer não significava",
"t0": 109.09287486910996,
"t1": 112.58947172774872,
"speaker": null,
"clip": "n07"
},
{
"text": "deixar de pertencer.",
"t0": 112.58947172774872,
"t1": 115.03990000000002,
"speaker": null,
"clip": "n07"
}
],
