{
 "duration": 84.827,
 "blocks": [
  {
   "name": "c01_rival",
   "who": "rival",
   "s": 1.0,
   "e": 4.626,
   "text": "Você veio apresentar isso ao imperador?",
   "scene": 1
  },
  {
   "name": "c02_narr",
   "who": "narrador",
   "s": 6.226,
   "e": 12.628,
   "text": "O imperador estava velho e decidiu escolher seu sucessor de uma maneira bastante curiosa.",
   "scene": 2
  },
  {
   "name": "c02_imp",
   "who": "imperador",
   "s": 13.078,
   "e": 17.082,
   "text": "Cada criança receberá uma semente.",
   "scene": 2
  },
  {
   "name": "c03_imp",
   "who": "imperador",
   "s": 18.382,
   "e": 23.835,
   "text": "Daqui a um ano, retornem com aquilo que conseguirem cultivar.",
   "scene": 3
  },
  {
   "name": "c04_narr",
   "who": "narrador",
   "s": 24.935,
   "e": 31.02,
   "text": "Ping tinha um talento especial. Quase tudo que plantava florescia. Quase tudo...",
   "scene": 4
  },
  {
   "name": "c05_ping",
   "who": "ping",
   "s": 34.62,
   "e": 36.62,
   "text": "O que você está precisando?",
   "scene": 5
  },
  {
   "name": "c06_ping",
   "who": "ping",
   "s": 39.82,
   "e": 43.464,
   "text": "Pai, não posso aparecer lá de mãos vazias.",
   "scene": 6
  },
  {
   "name": "c06_pai",
   "who": "pai",
   "s": 43.914,
   "e": 46.194,
   "text": "Mas você fez o seu melhor, não fez?",
   "scene": 6
  },
  {
   "name": "c07_pai",
   "who": "pai",
   "s": 47.594,
   "e": 50.303,
   "text": "Então leve o resultado do seu esforço.",
   "scene": 7
  },
  {
   "name": "c08_imp",
   "who": "imperador",
   "s": 53.903,
   "e": 55.693,
   "text": "E a sua flor?",
   "scene": 8
  },
  {
   "name": "c08_ping",
   "who": "ping",
   "s": 56.593,
   "e": 61.516,
   "text": "Majestade, eu tentei. Mas a semente não cresceu.",
   "scene": 8
  },
  {
   "name": "c09_imp",
   "who": "imperador",
   "s": 63.116,
   "e": 70.878,
   "text": "Todas as sementes que entreguei haviam sido fervidas. Nenhuma poderia germinar.",
   "scene": 9
  },
  {
   "name": "c10_imp",
   "who": "imperador",
   "s": 73.878,
   "e": 78.156,
   "text": "Enfim encontrei alguém digno de governar.",
   "scene": 10
  },
  {
   "name": "c10_narr",
   "who": "narrador",
   "s": 79.056,
   "e": 83.627,
   "text": "Entre tantas flores, foi um pote vazio que revelou a verdade.",
   "scene": 10
  }
 ],
