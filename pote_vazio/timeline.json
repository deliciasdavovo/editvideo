{
 "duration": 83.41,
 "blocks": [
  {
   "name": "narr_b1_novo",
   "who": "narrador",
   "s": 0.146,
   "e": 7.182,
   "text": "Ping fazia qualquer planta florir. Mas a semente mais importante da vida dele não quis nascer."
  },
  {
   "name": "narr_b2_novo",
   "who": "narrador",
   "s": 7.91,
   "e": 15.718,
   "text": "O imperador era velho, sem filhos, e amava flores. Por isso, deu uma semente a cada criança."
  },
  {
   "name": "imp_b2_v2",
   "who": "imperador",
   "s": 16.107,
   "e": 23.18,
   "text": "Quem me trouxer a flor mais bonita em um ano será o próximo imperador."
  },
  {
   "name": "narr_b3",
   "who": "narrador",
   "s": 23.714,
   "e": 32.235,
   "text": "Ping plantou e regou todo dia. Nada nasceu. Trocou a terra. Nada. Passou para um vaso maior. Nada."
  },
  {
   "name": "narr_b4a",
   "who": "narrador",
   "s": 32.769,
   "e": 38.129,
   "text": "Na primavera, as crianças passaram com flores enormes. Ping teve vergonha."
  },
  {
   "name": "ping_b4",
   "who": "ping",
   "s": 38.469,
   "e": 41.218,
   "text": "Pai, eu não posso levar um vaso vazio."
  },
  {
   "name": "narr_b4b",
   "who": "narrador",
   "s": 41.587,
   "e": 46.039,
   "text": "Mas o pai disse que Ping fez o seu melhor, e isso bastava."
  },
  {
   "name": "narr_b5",
   "who": "narrador",
   "s": 46.573,
   "e": 55.594,
   "text": "Então Ping levou o vaso vazio ao palácio. O imperador passou pelas flores de testa franzida, e parou em Ping."
  },
  {
   "name": "imp_b5",
   "who": "imperador",
   "s": 55.934,
   "e": 58.578,
   "text": "Por que você trouxe um vaso vazio?"
  },
  {
   "name": "ping_b5",
   "who": "ping",
   "s": 58.966,
   "e": 64.167,
   "text": "Eu cuidei da sua semente todo dia, mas ela não nasceu."
  },
  {
   "name": "imp_b6",
   "who": "imperador",
   "s": 64.895,
   "e": 70.346,
   "text": "Eu cozinhei todas as sementes. Nenhuma podia nascer."
  },
  {
   "name": "narr_b6",
   "who": "narrador",
   "s": 70.783,
   "e": 77.526,
   "text": "As outras flores vinham de sementes trocadas. Só Ping teve coragem de trazer a verdade."
  },
  {
   "name": "narr_b7",
   "who": "narrador",
   "s": 78.012,
   "e": 82.973,
   "text": "O menino que fazia tudo florir virou imperador com um vaso sem nenhuma flor."
  }
 ],
