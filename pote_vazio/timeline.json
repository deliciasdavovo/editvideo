{
 "duration": 89.958,
 "blocks": [
  {
   "name": "narr_b1b2_v2",
   "who": "narrador",
   "s": 0.146,
   "e": 23.344,
   "text": "Cem crianças trouxeram flores lindas ao imperador, e ele não sorriu para nenhuma. Só sorriu para um menino que chorava com um vaso vazio. Esse é o fim da história de Ping. Um ano antes, tudo que Ping plantava florescia. O imperador era velho, sem filhos, e amava flores. Por isso, deu uma semente a cada criança."
  },
  {
   "name": "imp_b2_v2",
   "who": "imperador",
   "s": 23.732,
   "e": 30.61,
   "text": "Quem me trouxer a flor mais bonita em um ano será o próximo imperador."
  },
  {
   "name": "narr_b3",
   "who": "narrador",
   "s": 31.144,
   "e": 39.683,
   "text": "Ping plantou e regou todo dia. Nada nasceu. Trocou a terra. Nada. Passou para um vaso maior. Nada."
  },
  {
   "name": "narr_b4a",
   "who": "narrador",
   "s": 40.217,
   "e": 45.579,
   "text": "Na primavera, as crianças passaram com flores enormes. Ping teve vergonha."
  },
  {
   "name": "ping_b4",
   "who": "ping",
   "s": 45.918,
   "e": 48.465,
   "text": "Pai, eu não posso levar um vaso vazio."
  },
  {
   "name": "narr_b4b",
   "who": "narrador",
   "s": 48.834,
   "e": 53.048,
   "text": "Mas o pai disse que Ping fez o seu melhor, e isso bastava."
  },
  {
   "name": "narr_b5",
   "who": "narrador",
   "s": 53.582,
   "e": 62.555,
   "text": "Então Ping levou o vaso vazio ao palácio. O imperador passou pelas flores de testa franzida, e parou em Ping."
  },
  {
   "name": "imp_b5",
   "who": "imperador",
   "s": 62.895,
   "e": 65.539,
   "text": "Por que você trouxe um vaso vazio?"
  },
  {
   "name": "ping_b5",
   "who": "ping",
   "s": 65.927,
   "e": 70.763,
   "text": "Eu cuidei da sua semente todo dia, mas ela não nasceu."
  },
  {
   "name": "imp_b6",
   "who": "imperador",
   "s": 71.491,
   "e": 76.941,
   "text": "Eu cozinhei todas as sementes. Nenhuma podia nascer."
  },
  {
   "name": "narr_b6",
   "who": "narrador",
   "s": 77.378,
   "e": 83.978,
   "text": "As outras flores vinham de sementes trocadas. Só Ping teve coragem de trazer a verdade."
  },
  {
   "name": "narr_b7",
   "who": "narrador",
   "s": 84.463,
   "e": 89.521,
   "text": "O menino que fazia tudo florir virou imperador com um vaso sem nenhuma flor."
  }
 ],
